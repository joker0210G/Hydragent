# ------------------------------------------------------------------------
# Hydragent configuration (v0.8.0)
#
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# Or just run `.\Hydragent.cmd onboard` (Windows) / `hydragent onboard`
# (Unix) and answer the wizard — it writes a .env for you.
#
# Quick map:
#   REQUIRED credentials:      Save keys securely in Vault via `/model set <provider> key <value>`
#   OPTIONAL config paths:     MODEL_PROVIDERS_PATH, DATA_DIR, WORKSPACE_DIR
#   OPTIONAL environment keys: BRAIN_<PROVIDER>_KEY, BRAIN_<PROVIDER>_BASE
#   OPTIONAL runtime tuning:   MAX_REACT_STEPS, LOG_LEVEL, LOG_FORMAT
#   OPTIONAL memory/dreaming:  ENABLE_DREAMING, DREAMING_INTERVAL_SEC,
#                              DREAM_BUDGET_MODE, ENABLE_CURATOR,
#                              CURATOR_INTERVAL_SEC, MAX_SEMANTIC_MEMORIES
#   OPTIONAL channel adapters: TELEGRAM_*, DISCORD_*, SLACK_*, EMAIL_*,
#                              WEBHOOK_*, HYDRA_BUS_BIND
#   OPTIONAL until vault-on:   HYDRAGENT_VAULT_PASSPHRASE
# ------------------------------------------------------------------------


# ── Model & Provider Configurations ──────────────────────────────────────────
# Hydragent uses `config/model_providers.yaml` (or whatever file is pointed to by
# MODEL_PROVIDERS_PATH) as the single source of truth for all models, aliases,
# and routing configurations.
#
# Credentials (API keys, custom endpoints) are stored securely inside the
# cryptographic Vault (`data/vault/.hydravault`) and loaded dynamically at startup.
#
# You do NOT need to set BRAIN_BASE, BRAIN_KEY, or BRAIN_MODEL in .env anymore!
# Instead, run `/model` inside the REPL (`hydragent chat`) to switch models, or
# `/model set <provider> key` to save credentials securely in the Vault.
#
# If you prefer to override base URLs or API keys via environment variables,
# you can use the provider-specific overrides below:
#
#   BRAIN_<PROVIDER_ID_UPPERCASE>_BASE and BRAIN_<PROVIDER_ID_UPPERCASE>_KEY
#
# Examples:
#   BRAIN_OPENAI_BASE=https://api.openai.com/v1
#   BRAIN_OPENAI_KEY=sk-...
#   BRAIN_OPENROUTER_BASE=https://openrouter.ai/api/v1
#   BRAIN_OPENROUTER_KEY=sk-or-v1-...
#   BRAIN_TOGETHER_BASE=https://api.together.xyz/v1
#   BRAIN_TOGETHER_KEY=your-together-key
#   BRAIN_OLLAMA_BASE=http://localhost:11434/v1
#   BRAIN_GROQ_BASE=https://api.groq.com/openai/v1
#   BRAIN_GROQ_KEY=your-groq-key  BRAIN_OLLAMA_BASE=http://localhost:11434
#   BRAIN_GROQ_BASE=https://api.groq.com/openai/v1
#   BRAIN_GROQ_KEY=your-groq-key


# ── Legacy aliases (still supported) ─────────────────────────────────────────
# If both the new BRAIN_* name and the legacy name are set, BRAIN_* wins.
#   OPENROUTER_API_KEYS  <->  BRAIN_KEY
#   PRIMARY_MODEL        <->  BRAIN_MODEL
#   FALLBACK_MODELS      <->  BRAIN_FALLBACKS
# If you leave BRAIN_BASE empty but set OPENROUTER_API_KEYS, the agent
# auto-uses https://openrouter.ai/api/v1 for backwards compatibility.


# ── Ollama-specific tuning (OPTIONAL) ─────────────────────────────────────────
# These are read when BRAIN_PROVIDER=ollama or when BRAIN_BASE points at an
# Ollama endpoint. All are optional — defaults are sane for most setups.
#
#   OLLAMA_API_BASE=http://localhost:11434   # Base URL (no /v1 suffix for Ollama native)
#   OLLAMA_MODEL=qwen2.5-coder:7b           # Overrides BRAIN_MODEL for Ollama
#   OLLAMA_API_TIMEOUT_SEC=300              # HTTP timeout per request (default: 300s)
#   OLLAMA_NUM_CTX=8192                     # Context window size (tokens)
#   OLLAMA_KEEP_ALIVE=5m                    # How long to keep the model in VRAM (e.g. 5m, -1)
#   OLLAMA_NUM_THREAD=8                     # CPU threads to use for inference
#   OLLAMA_TEMPERATURE=0.7                  # Sampling temperature (0.0 = deterministic)
#   OLLAMA_REPEAT_PENALTY=1.1               # Penalise recently used tokens
#   OLLAMA_TOP_P=0.9                        # Nucleus sampling threshold
#   OLLAMA_TOP_K=40                         # Top-K sampling cutoff


# ── OpenRouter-specific controls (OPTIONAL) ────────────────────────────────────
# Fine-tune OpenRouter's provider selection and routing behaviour.
#
#   OPENROUTER_SORT=throughput              # Sort providers by: price | throughput | latency
#   OPENROUTER_DATA_COLLECTION=deny         # allow | deny — opt out of OpenRouter training data
#   OPENROUTER_ALLOW_FALLBACKS=true         # Let OpenRouter use its own model fallback chain
#   OPENROUTER_REQUIRE_PARAMETERS=false     # Require providers to support all requested params
#   OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # Override base URL
#   OPENROUTER_TIMEOUT_SEC=120             # HTTP timeout per request


# ── Data Paths ────────────────────────────────────────────────────────────────
# Where session databases, skill library, audit log, and models live.
# Default is fine for local dev. Use an absolute path for production services.
DATA_DIR=./data

# Working directory for tool execution (file reads/writes, shell commands).
# Defaults to the current directory. Set to an absolute path to pin it.
#   WORKSPACE_DIR=/home/user/projects


# ── Encrypted vault (OPTIONAL) ────────────────────────────────────────────────
# Only required if you enable vault encryption. Leave UNSET for the default
# unencrypted local vault (fine for solo dev).
# When set, the vault is encrypted at rest with XChaCha20-Poly1305, and the
# key is derived from this passphrase via Argon2id.
#   HYDRAGENT_VAULT_PASSPHRASE=<your-secure-local-passphrase>


# ── Runtime Tuning ────────────────────────────────────────────────────────────
# Maximum ReAct loop steps before giving up. Higher = more autonomy,
# more tokens, more chance of drift. 10 is the default; 4-6 is enough
# for most tool-augmented Q&A.
MAX_REACT_STEPS=10

# Safety & Sandboxing
# When set to true, all code/tool executions run in an isolated WebAssembly sandbox.
# Set to false to run directly on host (agent will still prompt before dangerous actions).
ENFORCE_SANDBOX=false


# ── Logging ───────────────────────────────────────────────────────────────────
# Global log level for the kernel and all crates.
# Options: debug, info, warn, error
LOG_LEVEL=warn
# Format: json (machine-readable) or terminal (coloured, with symbols).
LOG_FORMAT=terminal
# Chat REPL log level — overrides LOG_LEVEL for `hydragent chat` only.
# Default is "error" so chat output stays clean. Set to "info" or "debug"
# to see what the kernel is doing under the hood.
#   HYDRAGENT_CHAT_LOG=error|warn|info|debug


# ── Developer toggles ─────────────────────────────────────────────────────────
# Reasoning trace: when set to 1, `hydragent chat` prints the model's hidden
# reasoning block in dim grey below each turn. No effect on non-reasoning models.
#   HYDRAGENT_SHOW_REASONING=1

# Raw stream: bypass the Markdown renderer and print the raw token stream.
# Useful for debugging model output formatting.
#   HYDRAGENT_STREAM_RAW=1

# Ollama pre-warming: the REPL evaluates a one-token prompt at startup to
# pre-warm the Ollama brain cache. Set to 1 to skip this and start instantly.
#   HYDRAGENT_SKIP_WARMUP=1


# ── Memory & Storage ──────────────────────────────────────────────────────────
# Maximum number of semantic memory facts stored. When exceeded, the oldest and
# lowest-importance rows are evicted. 0 disables semantic memory entirely.
MAX_SEMANTIC_MEMORIES=100


# ── Dreaming (memory consolidation background worker) ─────────────────────────
# The dreaming worker runs in the background, consolidating conversation logs
# into structured facts, style habits, behavior rules, and a knowledge graph
# (Pages → Books → Shelves via Graphify).

# Enable or disable the dreaming background worker entirely.
ENABLE_DREAMING=true

# How often the dreaming cycle runs (in seconds). Default: 60s.
# Can also be tuned at runtime with `/dream interval <N>` in the REPL.
#   DREAMING_INTERVAL_SEC=60

# Budget mode controls how much the dreaming cycle relies on LLM API calls.
# Options:
#   balanced  (default) — LLM extracts facts/summaries; Graphify runs locally.
#   turbo               — Zero LLM tokens: rule-based extraction + local FIFO
#                         compaction. Best for offline use or API cost control.
#   scholar             — Routes ALL dreaming calls (extraction, compaction,
#                         skill induction) to the strongest reasoning model
#                         (planning role). Best for deep consolidation sessions.
#   custom              — Balanced flow; plug in your own model_providers.yaml
#                         routing rules.
#   DREAM_BUDGET_MODE=balanced


# ── Curator (skill curation background worker) ────────────────────────────────
# The curator periodically reviews and consolidates the skill library, merging
# near-duplicate skills and promoting stable patterns.

# Enable or disable the curator.
ENABLE_CURATOR=true

# How often the curator runs (in seconds). Default: 86400s (24 hours).
#   CURATOR_INTERVAL_SEC=86400


# ── WorkIQ polling (OPTIONAL) ─────────────────────────────────────────────────
# Interval in seconds between WorkIQ task queue polls. Default: 300s (5 min).
#   WORK_IQ_POLL_INTERVAL_SEC=300


# ── Channel adapters (Python, OPTIONAL) ────────────────────────────────────────
# Each token is independent. Leave blank if you don't use that channel.
# The adapters live in adapters/<name>_adapter.py.

# Telegram
# Your Telegram Bot token from @BotFather. No quotes.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Comma-separated list of whitelisted Telegram Chat IDs.
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# Set to "pyngrok" to auto-tunnel the Mini App, or paste an HTTPS URL.
TELEGRAM_WEBAPP_URL=pyngrok
#   NGROK_AUTH_TOKEN=your-ngrok-auth-token-here

# Discord
#   DISCORD_BOT_TOKEN=your-discord-bot-token-here
#   DISCORD_ALLOWED_GUILD_IDS=123456789012345678
#   DISCORD_ALLOWED_CHANNEL_IDS=987654321098765432

# Slack
#   SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
#   SLACK_ALLOWED_CHANNEL_IDS=C01234567,C89012345

# Email
#   EMAIL_IMAP_HOST=imap.gmail.com
#   EMAIL_IMAP_PORT=993
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_USERNAME=you@gmail.com
#   EMAIL_PASSWORD=your-app-password     # use a Gmail app password, not your real one
#   EMAIL_ALLOWED_FROM_ADDRESSES=alice@example.com,bob@example.com

# Webhook
#   WEBHOOK_PORT=8765
#   WEBHOOK_SHARED_SECRET=random-string-shared-with-the-sender

# WebSocket bus (local-only by default — no env var needed for the default)
# To expose it (NOT recommended without a reverse proxy + auth):
#   HYDRA_BUS_BIND=0.0.0.0:5000
